# DRISHYAM backend configuration template.
# Copy to `.env` and fill in real values there. NEVER commit a filled-in .env.
# Every value below is a placeholder. No real credential belongs in this file.

# --- Core -----------------------------------------------------------------------------------
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
SECRET_KEY=replace-with-a-long-random-value
DATABASE_URL=postgresql+psycopg://drishyam:drishyam@localhost:5432/drishyam
REDIS_URL=redis://localhost:6379/0
ALLOWED_ORIGINS=http://localhost:5173

# --- Private evidence storage ---------------------------------------------------------------
STORAGE_BACKEND=filesystem
STORAGE_ROOT=./data/private_storage
GENERATED_REPORTS_ROOT=./generated_reports
MAX_UPLOAD_SIZE_BYTES=10485760
# Only required when STORAGE_BACKEND=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

# --- Email / OTP ----------------------------------------------------------------------------
EMAIL_PROVIDER=console
ALLOW_LOCAL_CONSOLE_EMAIL=false
OTP_PEPPER=replace-with-a-long-random-value
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5

# --- Trace Orb website assistant --------------------------------------------------------------
# Website help only. This assistant has no access to cases, evidence or accounts, and its
# credentials are deliberately NOT reused by the evidence pipeline below.
ASSISTANT_LLM_BASE_URL=
ASSISTANT_LLM_API_KEY=
ASSISTANT_LLM_MODEL=gpt-5-mini

# --- Evidence intelligence: local-first, Groq escalation --------------------------------------
# Deterministic extraction, provenance, confidence scoring, correlation and human review all work
# with both providers switched off. Models only add interpretation on top.
EVIDENCE_INTELLIGENCE_ENABLED=true

# local_first | local_only | groq_only | mock | disabled
LLM_ROUTING_MODE=local_first

# Local first pass. Install Ollama, then: `ollama pull qwen2.5vl:7b`
# On a weaker machine use qwen2.5vl:3b instead.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=qwen2.5vl:7b
OLLAMA_TIMEOUT_SECONDS=120
# Ollama defaults every model to 4096 tokens; a full-size screenshot needs far more.
OLLAMA_NUM_CTX=16384

# Escalation only, for low-confidence / conflicting / blurry / cropped evidence.
# Sending evidence to Groq requires BOTH switches below plus a key. Both default to off.
GROQ_ENABLED=false
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_ESCALATE_BELOW_CONFIDENCE=0.85
GROQ_MAX_RETRIES=1
GROQ_TIMEOUT_SECONDS=60

# Master consent switch for any evidence leaving this machine: disabled | enabled
EXTERNAL_EVIDENCE_TRANSMISSION=disabled

# Weak "same amount, near in time, no shared identifier" links. Off by default; always
# review-required when on.
SEMANTIC_CORRELATION_ENABLED=false

# --- Shared identifier ledger -----------------------------------------------------------------
# Lets two forces discover that they hold the same identifier without either seeing the other's
# case. Only a keyed digest, a case reference and a contact are ever published -- never the
# identifier itself and nothing about what a case contains.
#
# Off by default and behind three independent switches. Publishing is refused unless all three are
# satisfied; it never falls back to a weaker form.
LEDGER_ENABLED=false
LEDGER_PUBLICATION=disabled
# The key the participating districts share. WITHOUT IT THERE IS NO LEDGER: there are only about
# ten billion phone numbers, so an unkeyed digest of one can be enumerated in an afternoon and is
# the number itself with extra steps. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Every participating district must hold the same value, or their digests will not match.
LEDGER_KEY=
